---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeddingPricing from '../components/WeddingPricing.astro';
import SessionPricing from '../components/SessionPricing.astro';
import { sessionOffers, weddingOffers, weddingOptions } from '../data/offers';

// Le tarif événementiel est centralisé ici pour garder le contenu et le balisage synchronisés.
const eventOffer = {
  price: 330,
  priceLabel: '330 €',
  duration: 'Jusqu’à 2 h 30',
};

const offerItems = [
  ...weddingOffers.map((offer) => ({
    '@type': 'Offer',
    price: String(offer.price),
    priceCurrency: 'EUR',
    url: new URL(`/contact/?offre=${encodeURIComponent(`Mariage — ${offer.name}`)}#devis`, Astro.site).toString(),
    itemOffered: { '@type': 'Service', name: `Reportage mariage ${offer.name}`, areaServed: 'Avignon' },
  })),
  ...sessionOffers.map((offer) => ({
    '@type': 'Offer',
    price: String(offer.price),
    priceCurrency: 'EUR',
    url: new URL(`/contact/?offre=${encodeURIComponent(`Séance — ${offer.name}`)}#devis`, Astro.site).toString(),
    itemOffered: { '@type': 'Service', name: `Séance photo ${offer.name}`, areaServed: 'Avignon' },
  })),
  {
    '@type': 'Offer',
    url: new URL('/contact/?offre=%C3%89v%C3%A9nement#devis', Astro.site).toString(),
    description: `Reportage photo événementiel à partir de ${eventOffer.priceLabel}. Le devis confirme le périmètre et le prix total.`,
    itemOffered: { '@type': 'Service', name: 'Reportage photo événementiel', areaServed: 'Avignon' },
  },
];

const faqItems = [
  ['Quel est le tarif d’un photographe de mariage à Avignon ?', 'Les forfaits photo mariage Zirar Focus sont affichés à 1 750 €, 2 150 € et 2 500 € selon la durée de couverture, le nombre minimal de photos et l’heure de fin.'],
  ['Que comprennent les forfaits mariage ?', 'Chaque formule comprend les photos de couple, le traitement professionnel en haute définition, la livraison numérique et une galerie web privée.'],
  ['Combien coûte une séance photo à Avignon ?', 'La séance Express est proposée à 150 €, la séance d’une heure à 250 € et la formule Audacieuse à 350 €.'],
  ['La vidéo est-elle comprise ?', 'Les prix affichés concernent la photographie. Un film ou une formule photo et film reçoit une proposition personnalisée.'],
  ['Les déplacements autour d’Avignon sont-ils inclus ?', 'Le lieu précis est étudié avec votre demande. Le devis indique clairement les éventuels frais de déplacement avant la réservation.'],
  ['Comment réserver une date ?', 'Envoyez la date, le lieu et la prestation souhaitée. La réservation est confirmée après validation de la disponibilité, du devis et des conditions de la prestation.'],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': new URL('/tarifs-photographe-avignon/#page', Astro.site).toString(),
    name: 'Tarifs photographe à Avignon — Zirar Focus',
    url: new URL('/tarifs-photographe-avignon/', Astro.site).toString(),
    description: 'Tarifs des reportages mariage, séances photo et événements proposés par Zirar Focus à Avignon.',
    mainEntity: { '@type': 'OfferCatalog', name: 'Tarifs photo Zirar Focus', itemListElement: offerItems },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
  },
];
---

<BaseLayout
  title="Tarifs photographe Avignon : mariage & séance | Zirar Focus"
  description="Tarifs photographe à Avignon : mariage dès 1 750 €, séance photo dès 150 € et événement dès 330 €. Découvrez les services Zirar Focus et vérifiez votre date."
  schema={schema}
>
  <section class="rates-hero" aria-labelledby="rates-title">
    <div class="rates-hero__copy">
      <div class="rates-hero__inner">
        <p class="eyebrow eyebrow--light">Photographe & vidéaste · Avignon</p>
        <h1 id="rates-title">Des offres claires.<br /><em>Des souvenirs sans compromis.</em></h1>
        <p class="rates-hero__lead">Mariage, portrait, couple, famille ou événement : découvrez chaque prestation, ce qu’elle comprend et son tarif avant de nous parler de votre projet.</p>
        <div class="rates-hero__actions">
          <a class="button button--gold" href="/contact/#devis">Vérifier ma date <span aria-hidden="true">↗</span></a>
          <a class="rates-hero__call" href="tel:+33641189756"><span>Conseil direct</span>+33 6 41 18 97 56</a>
        </div>
        <div class="rates-hero__reassurance" aria-label="Repères de prestation">
          <span>Devis personnalisé</span><span>Images retouchées</span><span>Galerie privée</span>
        </div>
      </div>
    </div>
    <figure class="rates-hero__visual">
      <picture>
        <source media="(max-width: 800px)" srcset="/images/illustration-mariage-pexels-800.webp" />
        <img src="/images/illustration-mariage-pexels.webp" alt="Couple de mariés dans un décor végétal, image d’illustration" width="1600" height="2400" fetchpriority="high" />
      </picture>
      <figcaption>Inspiration mariage · Avignon & Provence · Image d’illustration</figcaption>
      <div class="rates-hero__starting"><span>Prestations</span><strong>dès 150 €</strong></div>
    </figure>
  </section>

  <nav class="rate-jump" aria-label="Accès rapide aux prestations">
    <div class="wrap rate-jump__inner">
      <a href="#mariage"><span>01</span><strong>Mariage</strong><small>Dès 1 750 €</small></a>
      <a href="#seances"><span>02</span><strong>Séances</strong><small>Dès 150 €</small></a>
      <a href="#evenements"><span>03</span><strong>Événements</strong><small>Dès {eventOffer.priceLabel}</small></a>
      <a href="#film"><span>04</span><strong>Photo + film</strong><small>Sur devis</small></a>
    </div>
  </nav>

  <section class="service-guide" aria-labelledby="service-guide-title">
    <div class="wrap service-guide__header">
      <div><p class="eyebrow">Choisir votre expérience</p><h2 id="service-guide-title">Quel moment voulez-vous raconter&nbsp;?</h2></div>
      <p>Chaque offre sert de point de départ. Votre devis confirme la date, le lieu, les horaires, les déplacements et les options choisies.</p>
    </div>
    <div class="wrap service-guide__grid">
      <a href="#mariage" class="service-tile service-tile--wedding">
        <span>01 · Mariage</span><div><h3>Le récit d’une journée</h3><p>Des préparatifs à la soirée, avec trois durées de couverture.</p></div><strong>Dès 1 750 € <i aria-hidden="true">↓</i></strong>
      </a>
      <a href="#seances" class="service-tile service-tile--portrait">
        <span>02 · Séances</span><div><h3>Un portrait qui vous ressemble</h3><p>Portrait, couple, grossesse, famille, professionnel ou boudoir.</p></div><strong>Dès 150 € <i aria-hidden="true">↓</i></strong>
      </a>
      <a href="#evenements" class="service-tile service-tile--event">
        <span>03 · Événements</span><div><h3>L’énergie de votre rendez-vous</h3><p>Réception, spectacle, lancement ou rencontre professionnelle.</p></div><strong>Dès {eventOffer.priceLabel} <i aria-hidden="true">↓</i></strong>
      </a>
    </div>
  </section>

  <WeddingPricing />
  <SessionPricing />

  <section class="event-offer" id="evenements" aria-labelledby="event-offer-title">
    <div class="event-offer__media">
      <img src="/images/portfolio/danse-scene-bleu.webp" alt="Reportage photo d’un spectacle de danse sur scène" width="1600" height="1067" loading="lazy" />
      <span>Scène · Réception · Entreprise</span>
    </div>
    <div class="event-offer__content">
      <p class="eyebrow eyebrow--light">Reportage événementiel · Avignon</p>
      <h2 id="event-offer-title">Des images prêtes<br /><em>à faire vivre l’événement.</em></h2>
      <p class="event-offer__lead">Pour une réception, un spectacle, un lancement ou une rencontre professionnelle, la couverture courte saisit l’ambiance, les détails et les temps forts.</p>
      <div class="event-offer__details">
        <ul><li>{eventOffer.duration} de présence</li><li>Sélection et retouche professionnelle</li><li>Livraison numérique des images</li></ul>
        <div><span>Reportage photo<br />à partir de</span><strong>{eventOffer.priceLabel}</strong></div>
      </div>
      <a class="button button--gold" href="/contact/?offre=%C3%89v%C3%A9nement#devis">Recevoir mon devis <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="film-offer" id="film" aria-labelledby="film-offer-title">
    <div class="wrap film-offer__grid">
      <div class="film-offer__number" aria-hidden="true">04</div>
      <div>
        <p class="eyebrow">Film & formule duo</p>
        <h2 id="film-offer-title">La photo saisit l’instant.<br /><em>Le film lui rend sa voix.</em></h2>
      </div>
      <div class="film-offer__aside">
        <p>Film de mariage, couverture vidéo d’un événement ou équipe photo + film : racontez-nous la durée, le lieu et le format attendu pour recevoir une proposition précise.</p>
        <a class="button dark" href="/contact/?offre=Film%20ou%20photo%20%2B%20film#devis">Composer ma formule <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="rates-options" aria-labelledby="options-title">
    <div class="wrap rates-options__grid">
      <div class="rates-options__intro">
        <p class="eyebrow">À la carte · Mariage</p>
        <h2 id="options-title">Prolongez<br /><em>votre histoire.</em></h2>
        <p>Ajoutez un album ou une séance avant ou après le mariage. Chaque option est confirmée avec votre reportage principal.</p>
        <a href="/contact/#devis">Parler de vos options <span aria-hidden="true">↗</span></a>
      </div>
      <div class="option-list">
        {weddingOptions.map((option, index) => <div><span><i>{String(index + 1).padStart(2, '0')}</i>{option.name}</span><strong>{option.price}</strong></div>)}
      </div>
    </div>
  </section>

  <section class="booking-steps" aria-labelledby="booking-title">
    <div class="wrap booking-steps__head">
      <div><p class="eyebrow">Comment ça marche&nbsp;?</p><h2 id="booking-title">Une réservation simple,<br /><em>du premier message à la galerie.</em></h2></div>
      <p>Vous savez toujours quelle est la prochaine étape et ce qui est inclus dans votre prestation.</p>
    </div>
    <div class="wrap booking-steps__grid">
      <article><span>01</span><h3>Votre demande</h3><p>Indiquez la prestation, la date et le lieu pour vérifier la disponibilité.</p></article>
      <article><span>02</span><h3>Votre devis</h3><p>Vous recevez une proposition détaillée avec la couverture et les options.</p></article>
      <article><span>03</span><h3>La préparation</h3><p>Nous échangeons sur le programme, les personnes et l’atmosphère souhaitée.</p></article>
      <article><span>04</span><h3>Vos images</h3><p>Votre sélection retouchée est remise selon le délai de la formule choisie.</p></article>
    </div>
  </section>

  <section class="rates-faq">
    <div class="wrap rates-faq__layout">
      <div class="rates-faq__intro"><p class="eyebrow">Questions fréquentes · Tarifs</p><h2>Tout savoir<br /><em>avant de réserver.</em></h2><p>Une question propre à votre date ou à votre lieu&nbsp;? Appelez Zirar Focus ou détaillez-la dans votre demande.</p><a href="tel:+33641189756">+33 6 41 18 97 56 <span aria-hidden="true">↗</span></a></div>
      <div class="faq">{faqItems.map(([question, answer], index) => <details open={index === 0}><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </div>
  </section>

  <section class="quote-panel quote-panel--rates"><div class="wrap"><p class="eyebrow">Votre projet commence ici</p><h2>Votre date est peut-être<br /><em>encore disponible.</em></h2><p>Quelques informations suffisent pour recevoir une réponse adaptée à votre mariage, votre séance ou votre événement.</p><div class="quote-panel__actions"><a class="button button--gold" href="/contact/#devis">Demander mon devis <span class="arrow" aria-hidden="true">↗</span></a><a href="tel:+33641189756">Ou appeler Zirar Focus</a></div></div></section>
</BaseLayout>

<style>
  .rates-hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(420px,.92fr);min-height:720px;background:#102018;color:#f5f8f3;overflow:hidden}
  .rates-hero__copy{display:flex;align-items:center;padding:clamp(70px,8vw,125px) max(36px,7vw) clamp(75px,9vw,135px) max(36px,calc((100vw - 1420px)/2));background:radial-gradient(circle at 15% 85%,rgba(89,151,108,.16),transparent 38%),#102018}
  .rates-hero__inner{width:min(100%,790px)}
  .rates-hero h1{max-width:900px;margin:0;color:#f7faf6;font-size:clamp(58px,6.25vw,104px)}.rates-hero h1 em{color:#c5e8ce}
  .rates-hero__lead{max-width:690px;margin:35px 0 0;color:#bdc9c0;font-size:clamp(16px,1.3vw,20px);line-height:1.72}
  .rates-hero__actions{display:flex;align-items:center;flex-wrap:wrap;gap:28px;margin-top:39px}
  .rates-hero__call{display:flex;flex-direction:column;padding-bottom:5px;border-bottom:1px solid #6d8f76;color:#f1f6f1;font-size:14px;font-weight:680}.rates-hero__call span{color:#91aa98;font-size:8px;font-weight:800;letter-spacing:.17em;text-transform:uppercase}
  .rates-hero__reassurance{display:flex;flex-wrap:wrap;gap:13px 27px;margin-top:50px;padding-top:24px;border-top:1px solid #385043;color:#a8b9ad;font-size:9px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.rates-hero__reassurance span{display:flex;align-items:center;gap:9px}.rates-hero__reassurance span:before{content:'✓';color:#c5e8ce}
  .rates-hero__visual{position:relative;min-height:720px;margin:0;overflow:hidden;background:#17291f}.rates-hero__visual:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(16,32,24,.22),transparent 24%),linear-gradient(0deg,rgba(5,12,8,.55),transparent 40%)}.rates-hero__visual picture,.rates-hero__visual img{display:block;width:100%;height:100%}.rates-hero__visual img{object-fit:cover;object-position:center 38%;filter:saturate(.84) contrast(1.04)}
  .rates-hero__visual figcaption{position:absolute;z-index:2;left:30px;bottom:25px;color:#f0f5ef;font-size:9px;font-weight:750;letter-spacing:.16em;text-transform:uppercase}
  .rates-hero__starting{position:absolute;z-index:3;right:0;top:50%;display:flex;flex-direction:column;width:180px;padding:27px 30px;background:#c5e8ce;color:#102018;transform:translateY(-50%)}.rates-hero__starting span{font-size:8px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.rates-hero__starting strong{margin:10px 0 0;font-size:26px;line-height:1;letter-spacing:-.04em}
  .rate-jump{position:sticky;top:124px;z-index:25;border-bottom:1px solid #c9d6cc;background:rgba(247,249,245,.96);backdrop-filter:blur(14px)}
  .rate-jump__inner{display:grid;grid-template-columns:repeat(4,1fr)}.rate-jump a{display:grid;grid-template-columns:auto 1fr;gap:1px 11px;padding:17px clamp(12px,2.2vw,32px);border-right:1px solid #d6dfd8;transition:background .2s}.rate-jump a:first-child{border-left:1px solid #d6dfd8}.rate-jump a:hover{background:#e5eee7}.rate-jump a>span{grid-row:1/3;color:#5d7967;font-size:9px;font-weight:800;letter-spacing:.1em}.rate-jump strong{font-size:10px;letter-spacing:.11em;text-transform:uppercase}.rate-jump small{color:#6d786f;font-size:9px}
  .service-guide{padding:clamp(90px,9vw,140px) 0;background:#f7f9f5}
  .service-guide__header{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(270px,.55fr);gap:clamp(35px,8vw,120px);align-items:end;margin-bottom:50px}.service-guide__header h2{max-width:920px;margin:0;font-size:clamp(48px,5.4vw,82px)}.service-guide__header>p{margin:0 0 7px;color:#5b685f;line-height:1.75}
  .service-guide__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.service-tile{position:relative;display:flex;flex-direction:column;min-height:400px;padding:clamp(27px,3vw,43px);overflow:hidden;background:#18271f;color:#fff;isolation:isolate}.service-tile:before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,12,8,.22),rgba(6,12,8,.88));z-index:-1}.service-tile:after{content:'';position:absolute;inset:0;background:center/cover no-repeat;z-index:-2;filter:saturate(.65);transition:transform .6s ease,filter .4s}.service-tile--wedding:after{background-image:url('/images/illustration-mariage-pexels-800.webp');background-position:center 37%}.service-tile--portrait:after{background-image:url('/images/portfolio/portrait-homme-noir-blanc-800.webp');background-position:center 26%}.service-tile--event:after{background-image:url('/images/portfolio/danse-mouvement-couleur-800.webp')}.service-tile:hover:after{transform:scale(1.035);filter:saturate(.95)}.service-tile>span{font-size:9px;font-weight:800;letter-spacing:.17em;text-transform:uppercase}.service-tile>div{margin-top:auto}.service-tile h3{margin:0 0 13px;color:#fff;font-size:clamp(31px,2.8vw,45px)}.service-tile p{max-width:360px;margin:0;color:#d1d7d1;font-size:13px}.service-tile>strong{display:flex;justify-content:space-between;margin-top:27px;padding-top:18px;border-top:1px solid rgba(255,255,255,.45);font-size:11px;letter-spacing:.1em;text-transform:uppercase}.service-tile i{font-style:normal;font-size:17px}
  .event-offer{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);min-height:740px;background:#112018;color:#f5f8f3;scroll-margin-top:175px}.event-offer__media{position:relative;min-height:650px;overflow:hidden}.event-offer__media:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(7,13,9,.65),transparent 45%)}.event-offer__media img{width:100%;height:100%;object-fit:cover;filter:saturate(.75) contrast(1.04)}.event-offer__media>span{position:absolute;z-index:1;left:clamp(25px,4vw,65px);bottom:34px;color:#fff;font-size:9px;font-weight:800;letter-spacing:.17em;text-transform:uppercase}
  .event-offer__content{display:flex;flex-direction:column;justify-content:center;padding:clamp(70px,8vw,130px) max(36px,calc((100vw - 1420px)/2)) clamp(70px,8vw,130px) clamp(40px,7vw,115px)}.event-offer h2{max-width:700px;margin:0 0 30px;color:#f7faf6;font-size:clamp(48px,5.2vw,82px)}.event-offer h2 em{color:#c5e8ce}.event-offer__lead{max-width:660px;margin:0;color:#b7c3ba;font-size:16px;line-height:1.78}
  .event-offer__details{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end;margin:40px 0}.event-offer__details ul{display:grid;gap:13px;margin:0;padding:0;list-style:none}.event-offer__details li{display:flex;gap:11px;color:#d8dfd9;font-size:12px}.event-offer__details li:before{content:'✓';color:#c5e8ce}.event-offer__details>div{display:grid;justify-items:end}.event-offer__details>div span{color:#91a397;font-size:8px;font-weight:800;letter-spacing:.13em;line-height:1.5;text-align:right;text-transform:uppercase}.event-offer__details strong{margin:10px 0 2px;font-size:clamp(50px,4.5vw,70px);line-height:1;letter-spacing:-.07em}.event-offer .button{align-self:flex-start}
  .film-offer{padding:clamp(90px,9vw,140px) 0;background:#f7f9f5;scroll-margin-top:175px}.film-offer__grid{display:grid;grid-template-columns:85px minmax(0,1.2fr) minmax(280px,.52fr);gap:clamp(30px,6vw,90px);align-items:end}.film-offer__number{color:#b7c5ba;font-size:12px;font-weight:800;letter-spacing:.16em}.film-offer h2{margin:0;font-size:clamp(48px,5.4vw,84px)}.film-offer__aside>p{margin:0 0 29px;color:#5d685f;line-height:1.75}.film-offer__aside .button{width:100%}
  .rates-options{padding:clamp(95px,10vw,155px) 0;background:#e3ece4}.rates-options__grid{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1fr);gap:clamp(55px,10vw,150px);align-items:start}.rates-options__intro h2{margin:0 0 27px}.rates-options__intro>p:not(.eyebrow){max-width:550px;color:#59675e;line-height:1.75}.rates-options__intro>a{display:inline-flex;gap:25px;margin-top:15px;padding-bottom:6px;border-bottom:1px solid #315d46;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.option-list{border-top:1px solid #a9baad}.option-list>div{display:flex;align-items:center;justify-content:space-between;gap:25px;padding:27px 0;border-bottom:1px solid #a9baad}.option-list span{display:flex;align-items:center;gap:22px;color:#29372e}.option-list i{color:#6c8373;font-size:9px;font-style:normal;font-weight:800;letter-spacing:.12em}.option-list strong{white-space:nowrap;color:#315d46;font-size:20px}
