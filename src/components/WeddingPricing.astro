---
import { weddingOffers as offers } from '../data/offers';
---

<section class="pricing" id="tarifs" aria-labelledby="pricing-title">
  <div class="wrap">
    <div class="pricing__intro">
      <div>
        <p class="eyebrow">Les tarifs · Mariage à Avignon</p>
        <h2 id="pricing-title">Des images fortes.<br /><em>Un cadre clair.</em></h2>
      </div>
      <p>Trois formules de reportage <strong>photo</strong>, avec les images retouchées et livrées dans une galerie privée. Le lieu et les éventuels déplacements sont précisés dans le devis.</p>
    </div>
    <div class="pricing__grid">
      {offers.map((offer, index) => (
        <article class:list={['pricing-card', { 'pricing-card--featured': offer.featured }]}>
          <div class="pricing-card__top"><span>{String(index + 1).padStart(2, '0')} / 03</span>{offer.featured && <span>Un récit complet</span>}</div>
          <h3>{offer.name}</h3>
          <p class="pricing-card__description">{offer.description}</p>
          <p class="pricing-card__price"><span>Forfait photo</span><strong>{offer.priceLabel}</strong></p>
          <ul>{offer.details.map((detail) => <li>{detail}</li>)}</ul>
          <a href={`/contact/?offre=${encodeURIComponent(`Mariage — ${offer.name}`)}#devis`} class="pricing-card__link">Demander un devis <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
    <div class="pricing__note"><p><strong>Envie d’un film ou d’une formule photo + film ?</strong> Décrivez votre projet : la partie vidéo reçoit une proposition sur mesure.</p><a href="tel:+33641189756">Parler de votre date : +33 6 41 18 97 56 ↗</a></div>
  </div>
</section>

<style>
  .pricing{background:#eaf0e8;color:#15241b;padding:clamp(90px,10vw,150px) 0;scroll-margin-top:135px}
  .pricing__intro{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);gap:clamp(30px,6vw,100px);align-items:end;margin-bottom:52px}
  .pricing__intro h2{margin:0;font-size:clamp(50px,6vw,88px)}
  .pricing__intro h2 em{color:#355f49}
  .pricing__intro>p{max-width:410px;margin:0 0 7px;color:#51534f;font-size:16px;line-height:1.7}
  .pricing__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .pricing-card{display:flex;flex-direction:column;min-width:0;padding:clamp(27px,3.2vw,48px);background:#fff;border:1px solid #cbd9cf}
  .pricing-card--featured{background:#15271d;color:#f8fbf7;border-color:#15271d}
  .pricing-card__top{display:flex;justify-content:space-between;gap:15px;min-height:20px;color:#526f5c;font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
  .pricing-card--featured .pricing-card__top{color:#c5e8ce}
  .pricing-card h3{margin:43px 0 15px;font-size:clamp(39px,3.5vw,57px)}
  .pricing-card__description{min-height:68px;max-width:320px;margin:0;color:#62645e;font-size:14px;line-height:1.55}
  .pricing-card--featured .pricing-card__description{color:#c2c7c0}
  .pricing-card__price{display:flex;flex-direction:column;gap:3px;margin:40px 0 30px;padding-bottom:28px;border-bottom:1px solid #cbd9cf}
  .pricing-card--featured .pricing-card__price{border-color:#56615a}
  .pricing-card__price span{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:#6a6d65}
  .pricing-card--featured .pricing-card__price span{color:#c2c7c0}
  .pricing-card__price strong{font-family:var(--serif);font-size:clamp(40px,4vw,61px);font-weight:700;letter-spacing:-.065em;line-height:1}
  .pricing-card ul{display:grid;gap:15px;margin:0 0 35px;padding:0;list-style:none}
  .pricing-card li{display:flex;gap:12px;color:#424740;font-size:13px;line-height:1.45}
  .pricing-card li:before{content:'↗';color:#355f49}
  .pricing-card--featured li{color:#e6e9e2}
  .pricing-card--featured li:before{color:#c5e8ce}
  .pricing-card__link{display:flex;justify-content:space-between;gap:15px;margin-top:auto;padding:16px 0 0;border-top:1px solid #cbd9cf;font-size:11px;font-weight:700;letter-spacing:.11em;text-transform:uppercase}
  .pricing-card--featured .pricing-card__link{border-color:#56615a}
  .pricing-card__link:hover{text-decoration:underline;text-underline-offset:5px}
  .pricing__note{display:flex;justify-content:space-between;align-items:center;gap:30px;padding-top:35px;color:#404741;font-size:13px}
  .pricing__note p{max-width:620px;margin:0}
  .pricing__note a{white-space:nowrap;border-bottom:1px solid currentColor;padding-bottom:3px;font-weight:700}
  @media(max-width:950px){.pricing__intro{grid-template-columns:1fr}.pricing__grid{grid-template-columns:1fr}.pricing-card__description{min-height:0}.pricing-card h3{margin-top:25px}.pricing__note{align-items:start;flex-direction:column}}
  @media(max-width:560px){.pricing__intro h2{font-size:clamp(48px,12vw,68px)}.pricing__note a{white-space:normal}}
</style>
