---
import { whatsappUrl } from '../data/contact';
---

<a
  class="whatsapp-button"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contacter Zirar Focus sur WhatsApp pour vérifier une disponibilité"
>
  <span class="whatsapp-button__icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" role="img" focusable="false">
      <path d="M16.04 3.2A12.7 12.7 0 0 0 5.1 22.32L3.2 28.8l6.64-1.75A12.77 12.77 0 1 0 16.04 3.2Zm0 22.94c-2.1 0-4.15-.57-5.93-1.65l-.43-.26-3.94 1.04 1.05-3.83-.28-.44a10.14 10.14 0 1 1 9.53 5.14Zm5.57-7.6c-.3-.16-1.8-.9-2.09-.99-.28-.1-.49-.15-.7.16-.2.3-.79.98-.97 1.18-.18.2-.36.23-.67.08-1.8-.9-2.98-1.61-4.18-3.65-.31-.54.32-.5.9-1.67.1-.2.05-.38-.02-.54-.08-.15-.7-1.68-.95-2.3-.25-.6-.51-.52-.7-.53h-.6c-.2 0-.54.08-.82.38-.28.3-1.07 1.05-1.07 2.56s1.1 2.97 1.25 3.18c.15.2 2.16 3.3 5.23 4.63 1.94.84 2.7.91 3.67.77 1.18-.18 1.8-1.2 2.06-2.36.25-1.15.25-2.13.18-2.33-.08-.21-.28-.31-.59-.46Z" />
    </svg>
  </span>
  <span class="whatsapp-button__copy">
    <strong>WhatsApp</strong>
    <small>Vérifier une date</small>
  </span>
</a>

<style>
  .whatsapp-button {
    position: fixed;
    z-index: 88;
    right: 22px;
    bottom: 22px;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 58px;
    padding: 8px 17px 8px 9px;
    border: 1px solid rgba(220, 184, 101, 0.7);
    border-radius: 999px;
    background: #163e2b;
    color: #fff;
    box-shadow: 0 13px 34px rgba(4, 17, 10, 0.3);
    text-decoration: none;
    transition: transform 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
  }

  .whatsapp-button:hover {
    transform: translateY(-3px);
    background: #1d5138;
    box-shadow: 0 17px 40px rgba(4, 17, 10, 0.38);
  }

  .whatsapp-button:focus-visible {
    outline: 3px solid #f2ce7e;
    outline-offset: 4px;
  }

  .whatsapp-button__icon {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    place-items: center;
    border-radius: 50%;
    background: #25d366;
    color: #092d19;
  }

  .whatsapp-button__icon svg {
    width: 25px;
    height: 25px;
    fill: currentColor;
  }

  .whatsapp-button__copy {
    display: grid;
    gap: 1px;
    line-height: 1.15;
  }

  .whatsapp-button__copy strong {
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .whatsapp-button__copy small {
    color: #e9c97f;
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  @media (max-width: 560px) {
    .whatsapp-button {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-button {
      transition: none;
    }

    .whatsapp-button:hover {
      transform: none;
    }
  }
</style>
