---
import { sessionOffers as offers } from '../data/offers';

const offerMeta: Record<string, { label: string; forWhom: string }> = {
  express: { label: 'Le format rapide', forWhom: 'Portrait · Couple · Famille · Professionnel' },
  portrait: { label: 'La séance complète', forWhom: 'Portrait · Couple · Grossesse · Famille' },
  audacieuse: { label: 'L’expérience signature', forWhom: 'Boudoir · Glamour' },
};
---

<section class="session-pricing" id="seances" aria-labelledby="session-pricing-title">
  <div class="wrap session-pricing__layout">
    <header class="session-pricing__intro">
      <p class="eyebrow eyebrow--light">Séances photo · Avignon</p>
      <h2 id="session-pricing-title">Une séance à votre rythme.</h2>
      <p>Portrait, couple, grossesse, famille ou image professionnelle : choisissez le temps et le nombre d’images qui correspondent à votre projet.</p>
      <div class="session-pricing__visual">
        <img src="/images/portfolio/portrait-homme-noir-blanc-800.webp" alt="Portrait en noir et blanc réalisé par Zirar Focus" width="800" height="1067" loading="lazy" />
        <span>Portraits signés<br />Zirar Focus</span>
      </div>
    </header>

    <div class="session-pricing__offers">
      {offers.map((offer, index) => (
        <article class:list={['session-row', { 'session-row--featured': offer.featured }]}>
          <div class="session-row__index"><span>{String(index + 1).padStart(2, '0')}</span></div>
          <div class="session-row__main">
            <div class="session-row__heading">
              <div><span>{offerMeta[offer.id]?.label}</span><h3>{offer.name}</h3></div>
              {offer.featured && <span class="session-row__choice">Séance complète</span>}
            </div>
            <p class="session-row__for">{offerMeta[offer.id]?.forWhom}</p>
            <p class="session-row__description">{offer.description}</p>
            <ul>{offer.details.map((detail) => <li>{detail}</li>)}</ul>
          </div>
          <div class="session-row__aside">
            <p><span>Tarif de la séance</span><strong>{offer.priceLabel}</strong></p>
            <a href={`/contact/?offre=${encodeURIComponent(`Séance — ${offer.name}`)}#devis`}>
              Choisir cette séance <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
      <p class="session-pricing__note"><span>Une envie différente&nbsp;?</span> Décrivez-la dans votre demande : le devis s’adapte au nombre de personnes, au lieu et au rendu souhaité.</p>
    </div>
  </div>
</section>

<style>
  .session-pricing{padding:clamp(95px,10vw,155px) 0;background:#112018;color:#f4f7f1;scroll-margin-top:175px}
  .session-pricing__layout{display:grid;grid-template-columns:minmax(280px,.62fr) minmax(0,1.38fr);gap:clamp(50px,8vw,125px);align-items:start}
  .session-pricing__intro{position:sticky;top:185px}
  .session-pricing__intro h2{max-width:570px;margin:0 0 28px;color:#f7faf6;font-size:clamp(50px,5.3vw,81px)}
  .session-pricing__intro>p:not(.eyebrow){max-width:510px;margin:0;color:#b9c7bd;font-size:15px;line-height:1.75}
  .session-pricing__visual{position:relative;width:min(100%,410px);height:260px;margin-top:42px;overflow:hidden;border:1px solid rgba(197,232,206,.28)}
  .session-pricing__visual:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(7,15,10,.8))}
  .session-pricing__visual img{width:100%;height:100%;object-fit:cover;object-position:center 29%;filter:contrast(1.05)}
  .session-pricing__visual span{position:absolute;z-index:1;left:21px;bottom:18px;color:#f5f8f3;font-size:9px;font-weight:750;letter-spacing:.15em;line-height:1.6;text-transform:uppercase}
  .session-pricing__offers{border-top:1px solid #40574a}
  .session-row{display:grid;grid-template-columns:45px minmax(0,1fr) minmax(185px,.38fr);gap:clamp(18px,3vw,43px);padding:clamp(35px,4vw,58px) 0;border-bottom:1px solid #40574a;transition:padding .25s ease,background .25s ease}
  .session-row__index{color:#91af99;font-size:10px;font-weight:800;letter-spacing:.15em}
  .session-row__heading{display:flex;align-items:start;justify-content:space-between;gap:18px}
  .session-row__heading>div>span{display:block;margin-bottom:8px;color:#9cb4a2;font-size:9px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}
  .session-row h3{margin:0;color:#f5f8f3;font-size:clamp(37px,3.3vw,54px)}
  .session-row__choice{margin-top:9px;padding:6px 9px;background:#c5e8ce;color:#102018;font-size:8px;font-weight:850;letter-spacing:.13em;text-transform:uppercase;white-space:nowrap}
  .session-row__for{margin:17px 0 11px;color:#c5e8ce;font-size:10px;font-weight:750;letter-spacing:.1em;text-transform:uppercase}
  .session-row__description{max-width:600px;margin:0 0 24px;color:#acb9b0;font-size:14px;line-height:1.65}
  .session-row ul{display:grid;grid-template-columns:1fr 1fr;gap:10px 24px;margin:0;padding:0;list-style:none}
  .session-row li{display:flex;gap:9px;color:#d8dfd9;font-size:12px;line-height:1.45}.session-row li:before{content:'•';color:#c5e8ce}
  .session-row__aside{display:flex;flex-direction:column;align-items:flex-end;text-align:right}
  .session-row__aside p{display:grid;justify-items:end;margin:0 0 28px}.session-row__aside p>span{color:#91a397;font-size:9px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}
  .session-row__aside strong{margin-top:10px;color:#f7faf6;font-size:clamp(43px,3.8vw,60px);line-height:1;letter-spacing:-.065em}
  .session-row__aside>a{display:flex;justify-content:space-between;gap:22px;width:100%;margin-top:auto;padding:15px 0;border-block:1px solid #6b8272;color:#f3f7f2;font-size:9px;font-weight:800;letter-spacing:.11em;text-align:left;text-transform:uppercase;transition:color .2s,border-color .2s}.session-row__aside>a:hover{border-color:#c5e8ce;color:#c5e8ce}
  .session-pricing__note{display:flex;gap:20px;margin:25px 0 0;color:#95a69a;font-size:12px;line-height:1.6}.session-pricing__note span{flex:0 0 auto;color:#c5e8ce;font-weight:750}
  @media(max-width:1050px){.session-pricing__layout{grid-template-columns:1fr}.session-pricing__intro{position:static}.session-pricing__visual{width:100%;max-width:none;height:min(52vw,430px)}.session-pricing__visual img{object-position:center 25%}}
  @media(max-width:720px){.session-row{grid-template-columns:30px 1fr}.session-row__aside{grid-column:2;align-items:stretch;text-align:left}.session-row__aside p{justify-items:start}.session-row__aside>a{max-width:320px}.session-row ul{grid-template-columns:1fr}.session-pricing__note{display:block}.session-pricing__note span{display:block;margin-bottom:6px}}
  @media(max-width:560px){.session-pricing{scroll-margin-top:140px}.session-pricing__intro h2{font-size:clamp(46px,13vw,67px)}.session-row{grid-template-columns:1fr}.session-row__index{display:none}.session-row__aside{grid-column:auto}.session-row__heading{display:block}.session-row__choice{display:inline-block;margin-top:14px}.session-pricing__visual{height:310px}}
</style>
