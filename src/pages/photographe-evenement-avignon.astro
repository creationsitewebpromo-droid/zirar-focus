---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import { portfolio } from '../data/portfolio';

const eventPortfolio = portfolio.filter((item) => item.collection === 'evenement' && item.width >= 1200);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': new URL('/photographe-evenement-avignon/#service', Astro.site).toString(),
  name: 'Photographie et film événementiels à Avignon',
  description: 'Couverture photo et film d’événements à Avignon et en Provence.',
  provider: { '@id': new URL('/#studio', Astro.site).toString() },
  areaServed: { '@type': 'City', name: 'Avignon' },
  url: new URL('/photographe-evenement-avignon/', Astro.site).toString(),
  mainEntityOfPage: new URL('/photographe-evenement-avignon/', Astro.site).toString(),
};
---
<BaseLayout title="Photographe événementiel Avignon : tarifs | Zirar Focus" description="Photographe et vidéaste événementiel à Avignon. Reportage photo dès 330 €, film sur devis. Découvrez le portfolio et demandez un devis Zirar Focus." schema={schema}>
  <section class="page-hero"><div class="wrap"><p class="eyebrow">Événementiel · Avignon & Provence</p><h1>Photographe événementiel à Avignon.<br /><em>Votre énergie, en images.</em></h1><p class="lead">Des images qui saisissent l’énergie d’un moment, la beauté des détails et les personnes qui lui donnent vie.</p></div></section>
  <section class="section"><div class="wrap split-section"><div><p class="eyebrow">Photographe événementiel Avignon</p><h2>L’ambiance d’un jour, <em>la force du souvenir.</em></h2><div class="prose"><p>Une réception, une célébration ou un événement conçu avec soin mérite des images à la hauteur. Zirar Focus réalise des reportages photo et film pour garder une trace juste de ce qui s’est vécu.</p><p>À Avignon et en Provence, chaque couverture s’adapte au lieu, au rythme et aux personnes qui composent votre événement.</p></div></div><div class="motif-panel event" aria-hidden="true"></div></div></section>
  <section class="portfolio-section"><div class="wrap"><div class="section-head section-head--dark"><div><p class="eyebrow eyebrow--light">Extraits de réalisations</p><h2>L’événement, <em>en images.</em></h2></div><div class="section-aside"><p>Scène et danse saisies au cœur de l’action.</p><a class="text-link text-link--light" href="/galerie/">Voir tout le portfolio</a></div></div><PortfolioGrid items={eventPortfolio} compact={true} /></div></section>
  <section class="section" style="background:var(--cream)"><div class="wrap"><p class="eyebrow">L’approche</p><h2>Le détail et <em>l’ensemble.</em></h2><div class="feature-grid"><div class="feature"><span class="number">01</span><h3>Les personnes</h3><p>Les échanges, les émotions et les instants spontanés au cœur de l’événement.</p></div><div class="feature"><span class="number">02</span><h3>L’atmosphère</h3><p>La lumière, le lieu et les détails qui composent l’identité de votre réception.</p></div><div class="feature"><span class="number">03</span><h3>Votre récit</h3><p>Une proposition photo ou film ajustée à vos objectifs et aux temps forts de votre programme.</p></div></div></div></section>
  <section class="event-pricing" id="tarifs"><div class="wrap event-pricing__grid"><div><p class="eyebrow">Tarif · Événementiel</p><h2>Une présence juste.<br/><em>Un prix lisible.</em></h2><p>Pour une réception, une scène ou une rencontre à Avignon, la couverture photo courte commence à <strong>330 €</strong>. Ce point de départ comprend la prise de vue, la sélection et la retouche des images, puis une remise numérique.</p><p>Durée de référence : jusqu’à 2 h 30. Les déplacements, les usages professionnels et les projets de film sont détaillés dans votre devis.</p></div><div class="event-pricing__card"><span>Photo événementielle</span><strong>330 €</strong><small>à partir de · jusqu’à 2 h 30</small><a href="/contact/?offre=%C3%89v%C3%A9nement#devis">Demander un devis <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section"><div class="wrap split-section"><div class="motif-panel" aria-hidden="true"></div><div><p class="eyebrow">Votre projet</p><h2>Construisons une couverture <em>sur mesure.</em></h2><div class="prose"><p>Décrivez le type d’événement, la date, le lieu et les usages prévus pour les images. Ces informations permettent de définir ensemble une prestation adaptée et un devis clair.</p></div><a class="button dark" href="/contact/">Parler de l’événement <span class="arrow" aria-hidden="true">↗</span></a></div></div></section>
  <section class="quote-panel"><div class="wrap"><p class="eyebrow">Avignon · Provence · Ailleurs</p><h2>Faisons de ce moment <em>des images durables.</em></h2><p>Partagez les premières informations de votre projet pour commencer la conversation.</p><a class="button light" href="/contact/">Demander un devis <span class="arrow" aria-hidden="true">↗</span></a></div></section>
</BaseLayout>

<style>
  .event-pricing{padding:clamp(90px,10vw,150px) 0;background:#eaf0e8;scroll-margin-top:135px}
  .event-pricing__grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.5fr);gap:clamp(45px,9vw,145px);align-items:center}
  .event-pricing h2{font-size:clamp(50px,6vw,88px)}
  .event-pricing p:not(.eyebrow){max-width:680px;color:#4a514c;font-size:16px;line-height:1.75}
  .event-pricing__card{display:flex;flex-direction:column;padding:clamp(30px,4vw,60px);background:#15271d;color:#f7f6f0}
  .event-pricing__card>span{font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:#c5e8ce}
  .event-pricing__card strong{margin-top:55px;font-family:var(--serif);font-size:clamp(70px,8vw,118px);font-weight:700;line-height:1;letter-spacing:-.07em}
  .event-pricing__card small{color:#c8cec6;font-size:12px}
  .event-pricing__card a{display:flex;justify-content:space-between;margin-top:50px;padding-top:17px;border-top:1px solid #667268;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  @media(max-width:950px){.event-pricing__grid{grid-template-columns:1fr}.event-pricing__card strong{margin-top:30px}.event-pricing__card a{margin-top:35px}}
</style>
