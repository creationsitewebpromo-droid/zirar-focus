---
import { weddingOffers as offers } from '../data/offers';
---

<section class="wedding-pricing" id="mariage" aria-labelledby="wedding-pricing-title">
  <div class="wrap">
    <header class="wedding-pricing__header">
      <div class="wedding-pricing__heading">
        <p class="eyebrow">Reportage mariage · Avignon & Provence</p>
        <h2 id="wedding-pricing-title">Votre journée,<br /><em>racontée en entier.</em></h2>
      </div>
      <div class="wedding-pricing__promise">
        <p>Trois couvertures photo pensées selon le rythme de votre mariage. Chaque formule inclut la prise de vue, la sélection, la retouche et une galerie privée.</p>
        <ul aria-label="Inclus dans toutes les formules mariage">
          <li>Photos de couple</li>
          <li>Fichiers numériques HD</li>
          <li>Galerie web sécurisée</li>
        </ul>
      </div>
    </header>

    <div class="wedding-pricing__grid">
      {offers.map((offer, index) => (
        <article class:list={['wedding-card', { 'wedding-card--featured': offer.featured }]}>
          <div class="wedding-card__meta">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <span>{offer.featured ? 'Formule Signature' : 'Formule mariage'}</span>
          </div>
          <div class="wedding-card__title">
            <h3>{offer.name}</h3>
            {offer.featured && <span class="wedding-card__badge">Signature</span>}
          </div>
          <p class="wedding-card__description">{offer.description}</p>
          <p class="wedding-card__price">
            <span>Tarif de la formule</span>
            <strong>{offer.priceLabel}</strong>
          </p>
          <div class="wedding-card__included">
            <span>Votre reportage comprend</span>
            <ul>{offer.details.map((detail) => <li>{detail}</li>)}</ul>
          </div>
          <a href={`/contact/?offre=${encodeURIComponent(`Mariage — ${offer.name}`)}#devis`} class="wedding-card__cta">
            <span>Vérifier ma date</span><span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>

    <aside class="wedding-pricing__film" aria-label="Option vidéo de mariage">
      <div><span aria-hidden="true">▶</span><p><strong>Photo + film</strong>Votre journée racontée en images et en mouvement.</p></div>
      <p>Le film de mariage et les formules photo + vidéo sont composés selon votre journée.</p>
      <a href="/contact/?offre=Film%20ou%20photo%20%2B%20film#devis">Recevoir une proposition <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</section>

<style>
  .wedding-pricing{padding:clamp(95px,10vw,155px) 0;background:#edf2eb;color:#122018;scroll-margin-top:175px}
  .wedding-pricing__header{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.62fr);gap:clamp(45px,9vw,140px);align-items:end;margin-bottom:clamp(48px,6vw,78px)}
  .wedding-pricing__heading h2{max-width:890px;margin:0;font-size:clamp(51px,6.3vw,96px)}
  .wedding-pricing__heading h2 em{color:#315d46}
  .wedding-pricing__promise>p{margin:0 0 27px;color:#536158;font-size:16px;line-height:1.75}
  .wedding-pricing__promise ul{display:grid;gap:10px;margin:0;padding:20px 0 0;border-top:1px solid #bdcbbf;list-style:none}
  .wedding-pricing__promise li{display:flex;align-items:center;gap:12px;color:#273a2e;font-size:12px;font-weight:720;letter-spacing:.04em}
  .wedding-pricing__promise li:before{content:'';width:5px;height:5px;border-radius:50%;background:#315d46;box-shadow:0 0 0 4px rgba(49,93,70,.12)}
  .wedding-pricing__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:stretch}
  .wedding-card{position:relative;display:flex;flex-direction:column;min-width:0;padding:clamp(27px,3.1vw,46px);overflow:hidden;border:1px solid #c6d2c8;background:#fbfcf9;transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease}
  .wedding-card:before{content:'';position:absolute;inset:0 0 auto;height:4px;background:#315d46;transform:scaleX(0);transform-origin:left;transition:transform .3s ease}
  .wedding-card:hover{z-index:1;transform:translateY(-7px);border-color:#98ad9e;box-shadow:0 24px 60px rgba(20,39,28,.12)}
  .wedding-card:hover:before{transform:scaleX(1)}
  .wedding-card--featured{margin-block:-15px;padding-top:clamp(42px,4vw,61px);padding-bottom:clamp(42px,4vw,61px);border-color:#173021;background:#14271c;color:#f7faf6;box-shadow:0 28px 75px rgba(20,39,28,.2)}
  .wedding-card--featured:before{background:#c5e8ce;transform:scaleX(1)}
  .wedding-card__meta{display:flex;justify-content:space-between;gap:20px;color:#4e6d59;font-size:9px;font-weight:800;letter-spacing:.17em;text-transform:uppercase}
  .wedding-card--featured .wedding-card__meta{color:#a9cdb2}
  .wedding-card__title{display:flex;align-items:start;justify-content:space-between;gap:15px;margin:43px 0 17px}
  .wedding-card h3{margin:0;font-size:clamp(38px,3.4vw,55px)}
  .wedding-card__badge{margin-top:9px;padding:6px 9px;border:1px solid rgba(197,232,206,.42);color:#c5e8ce;font-size:8px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}
  .wedding-card__description{min-height:92px;margin:0;color:#5d685f;font-size:14px;line-height:1.65}
  .wedding-card--featured .wedding-card__description{color:#bdc8bf}
  .wedding-card__price{display:grid;gap:2px;margin:35px 0 0;padding:28px 0;border-block:1px solid #ccd7ce}
  .wedding-card--featured .wedding-card__price{border-color:#405749}
  .wedding-card__price>span{color:#68766c;font-size:9px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
  .wedding-card--featured .wedding-card__price>span{color:#9aafa0}
  .wedding-card__price strong{font-size:clamp(46px,4vw,64px);font-weight:670;line-height:.95;letter-spacing:-.07em}
  .wedding-card__included{padding:27px 0 33px}
  .wedding-card__included>span{display:block;margin-bottom:18px;color:#526158;font-size:9px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .wedding-card--featured .wedding-card__included>span{color:#9eb1a2}
  .wedding-card ul{display:grid;gap:13px;margin:0;padding:0;list-style:none}
  .wedding-card li{display:flex;gap:11px;color:#344139;font-size:13px;line-height:1.4}
  .wedding-card li:before{content:'✓';flex:0 0 auto;color:#315d46;font-weight:850}
  .wedding-card--featured li{color:#e0e8e1}.wedding-card--featured li:before{color:#c5e8ce}
  .wedding-card__cta{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:auto;padding:18px 19px;background:#14271c;color:#fff;font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;transition:background .25s,color .25s}
  .wedding-card__cta:hover{background:#315d46}.wedding-card__cta>span:last-child{font-size:18px;font-weight:400}
  .wedding-card--featured .wedding-card__cta{background:#c5e8ce;color:#14271c}.wedding-card--featured .wedding-card__cta:hover{background:#eef8f0}
  .wedding-pricing__film{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(260px,.8fr) auto;align-items:center;gap:clamp(30px,5vw,85px);margin-top:clamp(46px,6vw,75px);padding:30px 0;border-block:1px solid #b9c8bc}
  .wedding-pricing__film>div{display:flex;align-items:center;gap:17px}.wedding-pricing__film>div>span{display:grid;place-items:center;flex:0 0 49px;height:49px;border:1px solid #315d46;border-radius:50%;color:#315d46;font-size:10px}
  .wedding-pricing__film p{margin:0;color:#58665d;font-size:13px;line-height:1.55}.wedding-pricing__film strong{display:block;margin-bottom:3px;color:#15271d;font-size:18px}
  .wedding-pricing__film>a{padding:15px 0;border-bottom:1px solid #315d46;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
  .wedding-pricing__film>a span{margin-left:18px}
  @media(max-width:1050px){.wedding-pricing__grid{grid-template-columns:1fr}.wedding-card--featured{margin-block:0}.wedding-card__description{min-height:0}.wedding-pricing__film{grid-template-columns:1fr 1fr}.wedding-pricing__film>a{grid-column:1/-1;justify-self:start}}
  @media(max-width:800px){.wedding-pricing__header{grid-template-columns:1fr}.wedding-pricing__film{grid-template-columns:1fr}.wedding-pricing__film>a{grid-column:auto}.wedding-card__title{margin-top:28px}}
  @media(max-width:560px){.wedding-pricing{scroll-margin-top:140px}.wedding-pricing__heading h2{font-size:clamp(46px,13vw,67px)}.wedding-card__badge{display:none}.wedding-card__price strong{font-size:50px}.wedding-pricing__film>div{align-items:flex-start}}
</style>
