---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact & devis photographe Avignon | Zirar Focus" description="Contactez Zirar Focus pour votre mariage ou événement à Avignon, en Provence, en France ou au Maroc. Décrivez votre projet pour recevoir un devis personnalisé.">
  <div class="wrap contact-grid">
    <div><p class="eyebrow">Contact · Devis personnalisé</p><h1>Racontez-moi <em>votre projet.</em></h1><p class="lead">Une date, un lieu, une idée, une envie : partagez ce que vous imaginez. Chaque demande reçoit une réponse adaptée à votre projet.</p><div class="contact-aside"><p><strong>Basé à Avignon</strong><br/>Déplacements en Provence, France, Maroc et à l’international.</p><p>Vous pouvez aussi découvrir les réalisations sur <a href="https://www.instagram.com/zirar_focus/" target="_blank" rel="noopener noreferrer">Instagram ↗</a>.</p></div></div>
    <form class="contact-form" name="contact" method="POST" action="/merci/" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact" />
      <p hidden><label>Ne pas remplir ce champ <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <h2>Parlons-en.</h2><p>Les champs marqués * sont obligatoires.</p>
      <div class="form-grid">
        <div class="form-field"><label for="nom">Votre nom *</label><input id="nom" name="nom" autocomplete="name" required maxlength="120" /></div>
        <div class="form-field"><label for="email">Votre e-mail *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="200" /></div>
        <div class="form-field"><label for="type">Votre projet *</label><select id="type" name="type-de-projet" required><option value="" disabled selected>Choisir une prestation</option><option value="Mariage">Mariage</option><option value="Événement">Événement</option><option value="Autre projet">Autre projet</option></select></div>
        <div class="form-field"><label for="date">Date envisagée</label><input id="date" name="date" type="date" /></div>
        <div class="form-field full"><label for="lieu">Lieu envisagé</label><input id="lieu" name="lieu" placeholder="Avignon, Provence, Maroc…" maxlength="200" /></div>
        <div class="form-field full"><label for="message">Parlez-moi de votre projet *</label><textarea id="message" name="message" required minlength="20" maxlength="5000" placeholder="Le déroulé, l’ambiance, vos envies photo ou film…"></textarea></div>
      </div>
      <label class="form-check"><input type="checkbox" name="accord-confidentialite" value="oui" required /><span>J’accepte que mes informations soient utilisées pour répondre à ma demande, selon la <a href="/confidentialite/">politique de confidentialité</a>. *</span></label>
      <button class="button dark" type="submit">Envoyer ma demande <span class="arrow" aria-hidden="true">↗</span></button>
    </form>
  </div>
</BaseLayout>
