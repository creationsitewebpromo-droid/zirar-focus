---
import { sessionOffers as offers } from '../data/offers';
---

<section class="session-pricing" id="seances" aria-labelledby="session-pricing-title">
  <div class="wrap">
    <div class="session-pricing__intro">
      <div>
        <p class="eyebrow">Portraits & séances · Avignon</p>
        <h2 id="session-pricing-title">Un temps pour vous.<br /><em>Des images à garder.</em></h2>
      </div>
      <p>Portrait, couple, famille, grossesse, image professionnelle ou séance plus intime : choisissez un point de départ, puis précisez votre envie dans le formulaire.</p>
    </div>
    <div class="session-pricing__grid">
      {offers.map((offer) => (
        <article class:list={['session-card', { 'session-card--featured': offer.featured }]}>
          <p class="session-card__label">Séance photo · Avignon</p>
          <h3>{offer.name}</h3>
          <p class="session-card__description">{offer.description}</p>
          <p class="session-card__price"><strong>{offer.priceLabel}</strong><span>TTC</span></p>
          <ul>{offer.details.map((detail) => <li>{detail}</li>)}</ul>
          <a href={`/contact/?offre=${encodeURIComponent(`Séance — ${offer.name}`)}#devis`}>Choisir cette séance <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .session-pricing{padding:clamp(90px,10vw,150px) 0;background:#f6f8f4;scroll-margin-top:135px}
  .session-pricing__intro{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:clamp(30px,6vw,95px);align-items:end;margin-bottom:52px}
  .session-pricing__intro h2{margin:0;font-size:clamp(50px,6vw,88px)}
  .session-pricing__intro>p{max-width:440px;margin:0 0 7px;color:#596b60;font-size:16px;line-height:1.75}
  .session-pricing__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .session-card{display:flex;flex-direction:column;min-width:0;padding:clamp(28px,3.2vw,48px);border:1px solid #cbd9cf;background:#fff}
  .session-card--featured{background:#dff0e3;border-color:#9dbca5}
  .session-card__label{margin:0;color:#355f49;font-size:10px;font-weight:750;letter-spacing:.14em;text-transform:uppercase}
  .session-card h3{margin:35px 0 15px;font-size:clamp(38px,3.6vw,58px)}
  .session-card__description{min-height:80px;margin:0;color:#59635c;font-size:14px;line-height:1.6}
  .session-card__price{display:flex;align-items:end;gap:10px;margin:35px 0 28px;padding-bottom:26px;border-bottom:1px solid #cbd9cf}
  .session-card__price strong{font-size:clamp(47px,4.4vw,69px);line-height:1;letter-spacing:-.065em}
  .session-card__price span{padding-bottom:5px;color:#647068;font-size:10px;letter-spacing:.12em}
  .session-card ul{display:grid;gap:14px;margin:0 0 34px;padding:0;list-style:none}
  .session-card li{display:flex;gap:11px;color:#3f4b43;font-size:13px;line-height:1.5}
  .session-card li:before{content:'✓';color:#355f49;font-weight:800}
  .session-card>a{display:flex;justify-content:space-between;gap:15px;margin-top:auto;padding-top:17px;border-top:1px solid #cbd9cf;font-size:11px;font-weight:750;letter-spacing:.11em;text-transform:uppercase}
  .session-card>a:hover{text-decoration:underline;text-underline-offset:5px}
  @media(max-width:950px){.session-pricing__intro{grid-template-columns:1fr}.session-pricing__grid{grid-template-columns:1fr}.session-card__description{min-height:0}}
</style>
