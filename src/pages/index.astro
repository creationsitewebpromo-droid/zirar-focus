---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import { portfolio } from '../data/portfolio';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).toString(),
  name: 'Zirar Focus',
  url: new URL('/', Astro.site).toString(),
  inLanguage: 'fr-FR',
  publisher: { '@id': new URL('/#studio', Astro.site).toString() },
};
---

<BaseLayout
  title="Photographe & vidéaste à Avignon | Zirar Focus"
  description="Zirar Focus réalise vos photos et films à Avignon : mariages, événements et portraits en Provence, en France, au Maroc et à l’international."
  path="/"
  schema={websiteSchema}
>
  <section class="hero-home" aria-labelledby="hero-title">
    <div class="hero-home__copy">
      <div class="hero-home__inner">
        <p class="eyebrow eyebrow--light">Photographe & vidéaste · Avignon</p>
        <h1 id="hero-title">Les instants passent.<br /><em>Les images restent.</em></h1>
        <p class="hero-home__lead">Mariages, portraits et événements racontés avec un regard cinématographique, sensible et profondément humain.</p>
        <div class="hero-actions">
          <a class="button button--gold" href="/contact/">Racontez votre projet <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="text-link text-link--light" href="/galerie/">Explorer le portfolio</a>
        </div>
      </div>
      <div class="hero-home__places" aria-label="Zones d’intervention">
        <span>Avignon</span><i></i><span>France</span><i></i><span>Maroc</span><i></i><span>International</span>
      </div>
      <span class="hero-home__index" aria-hidden="true">Z / F</span>
    </div>

    <div class="hero-collage" aria-label="Sélection de photographies Zirar Focus">
      <figure class="hero-shot hero-shot--main">
        <img src="/images/portfolio/portrait-artiste.jpg" alt="Portrait expressif d’un artiste sur scène" width="640" height="426" fetchpriority="high" decoding="async" />
        <figcaption>Portrait · Scène</figcaption>
      </figure>
      <figure class="hero-shot hero-shot--reel">
        <img src="/images/portfolio/film-concert.jpg" alt="Tournage sur une scène de concert éclairée en vert" width="360" height="640" fetchpriority="high" decoding="async" />
        <figcaption>Film · Événement</figcaption>
      </figure>
      <figure class="hero-shot hero-shot--wide">
        <img src="/images/portfolio/danse-scene-blanc.jpg" alt="Ensemble de danseuses en blanc sur scène" width="640" height="449" decoding="async" />
        <figcaption>Mouvement · Lumière</figcaption>
      </figure>
      <span class="hero-collage__line" aria-hidden="true"></span>
    </div>
    <a class="scroll-cue" href="#regard"><span>Découvrir</span><i aria-hidden="true"></i></a>
  </section>

  <section id="regard" class="statement-section">
    <div class="wrap statement-grid">
      <p class="eyebrow">Un regard, une empreinte</p>
      <div>
        <h2>Photographier ce qui se voit.<br /><em>Révéler ce qui se ressent.</em></h2>
        <div class="statement-copy">
          <p>Zirar Focus transforme les gestes spontanés, les lumières fugitives et l’énergie d’une célébration en un récit visuel intemporel.</p>
          <p>Basé à Avignon, le studio accompagne les mariages et événements en Provence, en France, au Maroc et partout où votre histoire prend vie.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div><span>Mariages</span><b>✦</b><span>Événements</span><b>✦</b><span>Portraits</span><b>✦</b><span>Films</span><b>✦</b><span>Avignon</span><b>✦</b><span>Provence</span></div>
  </div>

  <section class="portfolio-section">
    <div class="wrap">
      <div class="section-head section-head--dark">
        <div><p class="eyebrow eyebrow--light">Portfolio sélectionné</p><h2>Des visages. Du mouvement.<br /><em>Une lumière singulière.</em></h2></div>
        <div class="section-aside"><p>Une sélection authentique de portraits, de spectacles et de reportages événementiels signés Zirar Focus.</p><a class="text-link text-link--light" href="/galerie/">Voir toute la galerie</a></div>
      </div>
      <PortfolioGrid items={portfolio.slice(0, 6)} compact={true} />
    </div>
  </section>

  <section class="services-section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Photo & film</p><h2>Votre histoire mérite<br /><em>plus qu’un souvenir.</em></h2></div>
        <p class="muted">Une présence attentive, une esthétique éditoriale et un accompagnement pensé autour de votre projet.</p>
      </div>
      <div class="service-list">
        <a class="service-row" href="/photographe-mariage-avignon/"><span class="number">01</span><div><small>Émotion · Élégance · Héritage</small><h3>Mariages</h3><p>Photographie & film à Avignon, en Provence et à destination.</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>
        <a class="service-row" href="/photographe-evenement-avignon/"><span class="number">02</span><div><small>Énergie · Détails · Rencontres</small><h3>Événements</h3><p>Reportages pour vos célébrations, spectacles et projets professionnels.</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>
        <a class="service-row" href="/contact/"><span class="number">03</span><div><small>Portrait · Film · Direction artistique</small><h3>Sur mesure</h3><p>Une création ajustée à votre univers, votre lieu et vos intentions.</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="cinema-panel" aria-labelledby="cinema-title">
    <img src="/images/portfolio/danse-mouvement-couleur.jpg" alt="Danseuses en mouvement sous des lumières colorées" width="640" height="427" loading="lazy" decoding="async" />
    <div class="cinema-panel__shade"></div>
    <div class="cinema-panel__content wrap">
      <p class="eyebrow eyebrow--light">L’art du mouvement</p>
      <h2 id="cinema-title">Une image peut arrêter le temps.<br /><em>Un film peut le faire revivre.</em></h2>
      <a class="button button--glass" href="https://www.instagram.com/zirar_focus/" target="_blank" rel="noopener noreferrer">Voir les films sur Instagram <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="locations-section">
    <div class="wrap locations-layout">
      <div><p class="eyebrow">Où nous retrouver</p><h2>Avignon comme ancrage.<br /><em>Le monde comme décor.</em></h2></div>
      <div class="locations">
        <div class="location"><span>01</span><strong>Avignon & Provence</strong><p>Mariages et événements dans le Vaucluse et le Sud de la France.</p></div>
        <div class="location"><span>02</span><strong>France</strong><p>Des histoires à raconter partout dans l’Hexagone.</p></div>
        <div class="location"><span>03</span><strong>Maroc & international</strong><p>Votre célébration, où qu’elle prenne vie.</p></div>
      </div>
    </div>
  </section>

  <section class="quote-panel">
    <div class="wrap"><p class="eyebrow eyebrow--light">Votre prochain chapitre</p><h2>Et si nous racontions<br /><em>votre histoire ensemble&nbsp;?</em></h2><p>Partagez la date, le lieu et l’atmosphère que vous imaginez. La conversation commence ici.</p><a class="button button--gold" href="/contact/">Parler de votre projet <span class="arrow" aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
