---
import '../styles/global.css';
import dmSansUrl from '../assets/fonts/dm-sans-latin.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = '/og-image.png',
  noindex = false,
  schema,
} = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const pathname = Astro.url.pathname;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#studio', Astro.site).toString(),
  name: 'Zirar Focus',
  url: new URL('/', Astro.site).toString(),
  telephone: '+33 6 41 18 97 56',
  description: 'Photographe et vidéaste de mariage et d’événement basé à Avignon, disponible en France, au Maroc et à l’international.',
  image: ogImage,
  logo: {
    '@type': 'ImageObject',
    '@id': new URL('/#logo', Astro.site).toString(),
    url: new URL('/images/logo-instagram.jpg', Astro.site).toString(),
    contentUrl: new URL('/images/logo-instagram.jpg', Astro.site).toString(),
    width: 150,
    height: 150,
  },
  sameAs: ['https://www.instagram.com/zirar_focus/'],
  areaServed: [
    { '@type': 'City', name: 'Avignon' },
    { '@type': 'AdministrativeArea', name: 'Vaucluse' },
    { '@type': 'AdministrativeArea', name: 'Provence' },
    { '@type': 'Country', name: 'France' },
    { '@type': 'Country', name: 'Maroc' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations photo et film',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          '@id': new URL('/photographe-mariage-avignon/#service', Astro.site).toString(),
          name: 'Photographie et film de mariage',
          url: new URL('/photographe-mariage-avignon/', Astro.site).toString(),
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          '@id': new URL('/photographe-evenement-avignon/#service', Astro.site).toString(),
          name: 'Photographie et film événementiels',
          url: new URL('/photographe-evenement-avignon/', Astro.site).toString(),
        },
      },
    ],
  },
};
const jsonLd = [organization, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111b17" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="GmYJacDjcgqtOqrVOTzsYxavrHkDw1qB4s-SPWYoUyg" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={dmSansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Zirar Focus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="header-meta">
        <div class="wrap header-meta__inner">
          <span>Photographe & vidéaste à Avignon · France · Maroc</span>
          <div><a href="tel:+33641189756">+33 6 41 18 97 56</a><span aria-hidden="true">/</span><a href="https://www.instagram.com/zirar_focus/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></div>
        </div>
      </div>
      <div class="header-inner wrap">
        <a href="/" class="brand" aria-label="Zirar Focus, accueil">
          <img class="brand-mark" src="/images/logo-instagram.jpg" alt="" width="150" height="150" />
          <span class="brand-wordmark">ZIRAR <span>FOCUS</span></span>
        </a>
        <nav class="desktop-nav" aria-label="Navigation principale">
          <a href="/photographe-mariage-avignon/" aria-current={pathname.startsWith('/photographe-mariage') ? 'page' : undefined}>Mariage</a>
          <a href="/photographe-evenement-avignon/" aria-current={pathname.startsWith('/photographe-evenement') ? 'page' : undefined}>Événements</a>
          <a href="/galerie/" aria-current={pathname === '/galerie/' ? 'page' : undefined}>Portfolio</a>
          <a href="/photographe-mariage-avignon/#tarifs">Tarifs</a>
          <a href="/a-propos/" aria-current={pathname === '/a-propos/' ? 'page' : undefined}>Le studio</a>
          <a href="/contact/" class="nav-cta">Parlons de votre projet <span aria-hidden="true">↗</span></a>
        </nav>
        <details class="mobile-menu">
          <summary aria-label="Menu principal"><span></span><span></span><span class="sr-only">Menu</span></summary>
          <nav aria-label="Navigation mobile">
            <a href="/photographe-mariage-avignon/" aria-current={pathname.startsWith('/photographe-mariage') ? 'page' : undefined}>Mariage</a>
            <a href="/photographe-evenement-avignon/" aria-current={pathname.startsWith('/photographe-evenement') ? 'page' : undefined}>Événements</a>
            <a href="/galerie/" aria-current={pathname === '/galerie/' ? 'page' : undefined}>Portfolio</a>
            <a href="/photographe-mariage-avignon/#tarifs">Tarifs</a>
            <a href="/a-propos/" aria-current={pathname === '/a-propos/' ? 'page' : undefined}>Le studio</a>
            <a href="/contact/" aria-current={pathname === '/contact/' ? 'page' : undefined}>Contact</a>
            <a href="tel:+33641189756">+33 6 41 18 97 56</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-top">
        <div>
          <p class="eyebrow eyebrow--light">Photo & film · Avignon</p>
          <p class="footer-brand">Zirar Focus<span class="gold-dot">.</span></p>
          <p>Des instants vrais, racontés avec sensibilité.</p>
        </div>
        <div class="footer-links">
          <div><span>Explorer</span><a href="/photographe-mariage-avignon/">Mariages</a><a href="/photographe-evenement-avignon/">Événements</a><a href="/galerie/">Portfolio</a><a href="/photographe-mariage-avignon/#tarifs">Tarifs</a><a href="/a-propos/">Le studio</a></div>
          <div><span>Échanger</span><a href="/contact/">Demander un devis</a><a href="tel:+33641189756">+33 6 41 18 97 56</a><a href="https://www.instagram.com/zirar_focus/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></div>
        </div>
      </div>
      <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Zirar Focus</span><span>Avignon · France · Maroc · International</span><a href="/confidentialite/">Confidentialité</a></div>
    </footer>
  </body>
</html>
