---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import { portfolio } from '../data/portfolio';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).toString(),
  name: 'Zirar Focus',
  url: new URL('/', Astro.site).toString(),
  inLanguage: 'fr-FR',
  publisher: { '@id': new URL('/#studio', Astro.site).toString() },
};
const featuredPortfolio = portfolio.filter((item) => item.width >= 1200);
---

<BaseLayout
  title="Photographe & vidéaste à Avignon | Zirar Focus"
  description="Zirar Focus réalise vos photos et films à Avignon : mariages, événements et portraits en Provence, en France, au Maroc et à l’international."
  path="/"
  schema={websiteSchema}
>
  <section class="hero-home" aria-labelledby="hero-title">
    <div class="hero-home__copy">
      <div class="hero-home__inner">
        <p class="eyebrow eyebrow--light">Photographe & vidéaste · Avignon</p>
        <h1 id="hero-title">Les instants passent.<br /><em>Les images restent.</em></h1>
        <p class="hero-home__lead">Mariages, portraits et événements racontés avec un regard cinématographique, sensible et profondément humain.</p>
        <div class="hero-actions">
          <a class="button button--gold" href="/contact/#devis">Vérifier ma date <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="text-link text-link--light" href="/tarifs-photographe-avignon/">Voir les tarifs</a>
        </div>
        <p class="hero-offer-line"><strong>Séances dès 150 €</strong><span aria-hidden="true">·</span><strong>Mariage dès 1 750 €</strong></p>
        <div class="hero-home__signature"><span aria-hidden="true">✦</span><p>Une photographie qui se ressent.<br />Un film qui se revit.</p></div>
      </div>
      <div class="hero-home__places" aria-label="Zones d’intervention">
        <span>Avignon</span><i></i><span>France</span><i></i><span>Maroc</span><i></i><span>International</span>
      </div>
      <span class="hero-home__index" aria-hidden="true">Z / F</span>
    </div>

    <div class="hero-collage" aria-label="Sélection de photographies Zirar Focus">
      <figure class="hero-shot hero-shot--main">
        <img src="/images/portfolio/danse-scene-blanc.webp" srcset="/images/portfolio/danse-scene-blanc-800.webp 800w, /images/portfolio/danse-scene-blanc.webp 1440w" sizes="(max-width: 950px) 62vw, 40vw" alt="Ensemble de danseuses en blanc sur scène" width="1440" height="1010" fetchpriority="high" decoding="async" />
        <figcaption>Danse · Scène</figcaption>
      </figure>
      <figure class="hero-shot hero-shot--reel">
        <img src="/images/portfolio/portrait-homme-noir-blanc.webp" srcset="/images/portfolio/portrait-homme-noir-blanc-800.webp 800w, /images/portfolio/portrait-homme-noir-blanc.webp 1440w" sizes="(max-width: 950px) 38vw, 22vw" alt="Portrait en noir et blanc réalisé par Zirar Focus" width="1440" height="1920" fetchpriority="high" decoding="async" />
        <figcaption>Portrait · Regard</figcaption>
      </figure>
      <figure class="hero-shot hero-shot--wide">
        <img src="/images/portfolio/danse-mouvement-couleur.webp" srcset="/images/portfolio/danse-mouvement-couleur-800.webp 800w, /images/portfolio/danse-mouvement-couleur.webp 1600w" sizes="(max-width: 950px) 62vw, 40vw" alt="Danseuses en mouvement sous des lumières colorées" width="1600" height="1066" loading="lazy" decoding="async" />
        <figcaption>Mouvement · Lumière</figcaption>
      </figure>
      <span class="hero-collage__line" aria-hidden="true"></span>
    </div>
    <a class="scroll-cue" href="#regard"><span>Découvrir</span><i aria-hidden="true"></i></a>
  </section>

  <section id="regard" class="statement-section">
    <div class="wrap statement-grid">
      <p class="eyebrow">Un regard, une empreinte</p>
      <div>
        <h2>Photographier ce qui se voit.<br /><em>Révéler ce qui se ressent.</em></h2>
        <div class="statement-copy">
          <p>Zirar Focus transforme les gestes spontanés, les lumières fugitives et l’énergie d’une célébration en un récit visuel intemporel.</p>
          <p>Basé à Avignon, le studio accompagne les mariages et événements en Provence, en France, au Maroc et partout où votre histoire prend vie.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div><span>Mariages</span><b>✦</b><span>Événements</span><b>✦</b><span>Portraits</span><b>✦</b><span>Films</span><b>✦</b><span>Avignon</span><b>✦</b><span>Provence</span></div>
  </div>

  <section class="home-offers" aria-labelledby="home-offers-title">
    <div class="wrap">
      <div class="home-offers__head">
        <div><p class="eyebrow">Réserver Zirar Focus · Avignon</p><h2 id="home-offers-title">Choisissez votre projet.<br /><em>Vérifiez votre date.</em></h2></div>
        <div><p>Des prestations photo aux tarifs visibles, puis un devis qui confirme votre date, votre lieu et les options souhaitées.</p><a class="text-link" href="/tarifs-photographe-avignon/">Comparer tous les tarifs <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="home-offers__grid">
        <article class="home-offer-card">
          <span>01 · Mariage</span>
          <h3>Votre journée,<br />en récit.</h3>
          <p>Reportage des préparatifs jusqu’au cocktail, avec 250 photos ou plus et une galerie privée.</p>
          <div><small>Forfait photo dès</small><strong>1 750 €</strong></div>
          <a href="/contact/?offre=Mariage%20%E2%80%94%20Essentielle#devis">Vérifier ma date <span aria-hidden="true">↗</span></a>
        </article>
        <article class="home-offer-card home-offer-card--featured">
          <span>02 · Séance photo</span>
          <h3>Un moment<br />pour vous.</h3>
          <p>Portrait, couple, famille, grossesse ou image professionnelle, guidé avec soin à Avignon.</p>
          <div><small>Séance dès</small><strong>150 €</strong></div>
          <a href="/contact/?offre=S%C3%A9ance%20%E2%80%94%20Express#devis">Choisir ma séance <span aria-hidden="true">↗</span></a>
        </article>
        <article class="home-offer-card">
          <span>03 · Événement</span>
          <h3>Votre énergie,<br />bien captée.</h3>
          <p>Réception, spectacle, lancement ou rencontre professionnelle, jusqu’à 2 h 30.</p>
          <div><small>Reportage photo dès</small><strong>330 €</strong></div>
          <a href="/contact/?offre=%C3%89v%C3%A9nement#devis">Recevoir mon devis <span aria-hidden="true">↗</span></a>
        </article>
      </div>
      <p class="home-offers__reassurance"><span>✓ Images retouchées</span><span>✓ Livraison numérique</span><span>✓ Galerie privée</span><span>✓ Avignon & Provence</span></p>
    </div>
  </section>

  <section class="portfolio-section">
    <div class="wrap">
      <div class="section-head section-head--dark">
        <div><p class="eyebrow eyebrow--light">Portfolio sélectionné</p><h2>Des visages. Du mouvement.<br /><em>Une lumière singulière.</em></h2></div>
        <div class="section-aside"><p>Une sélection authentique de portraits, de spectacles et de reportages événementiels signés Zirar Focus.</p><a class="text-link text-link--light" href="/galerie/">Voir toute la galerie</a></div>
      </div>
      <PortfolioGrid items={featuredPortfolio} compact={true} />
    </div>
  </section>

  <section class="services-section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Photo & film</p><h2>Votre histoire mérite<br /><em>plus qu’un souvenir.</em></h2></div>
        <p class="muted">Une présence attentive, une esthétique éditoriale et un accompagnement pensé autour de votre projet.</p>
      </div>
      <div class="service-list">
        <a class="service-row" href="/photographe-mariage-avignon/"><span class="number">01</span><div><small>Mariage · Photo dès 1 750 €</small><h3>Mariages</h3><p>Trois formules de reportage à Avignon, en Provence et à destination.</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>
        <a class="service-row" href="/photographe-evenement-avignon/"><span class="number">02</span><div><small>Événement · Photo dès 330 €</small><h3>Événements</h3><p>Reportages pour vos célébrations, spectacles et projets professionnels.</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>
        <a class="service-row" href="/tarifs-photographe-avignon/#seances"><span class="number">03</span><div><small>Portrait · Couple · Famille · Dès 150 €</small><h3>Séances photo</h3><p>Des formats de 15 minutes à 1 h 30, avec des photos retouchées.</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>
      </div>
      <div class="services-tail"><p>Vous avez déjà une date ou une idée de prestation&nbsp;?</p><a class="text-link" href="/tarifs-photographe-avignon/">Voir tous les tarifs <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="cinema-panel" aria-labelledby="cinema-title">
    <div class="wrap cinema-panel__grid">
      <div class="cinema-panel__content">
        <p class="eyebrow eyebrow--light">Le mouvement, en héritage</p>
        <span class="cinema-panel__edition">02 / Film & émotion</span>
        <h2 id="cinema-title">Une image arrête le temps.<br /><em>Un film le fait revivre.</em></h2>
        <p>La voix, un geste, l’énergie d’une scène : le film prolonge ce que la photographie a saisi. Découvrez un extrait réalisé par Zirar Focus.</p>
        <a class="text-link text-link--light" href="/galerie/#film-feature-title">Découvrir les films <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="cinema-panel__media">
        <video controls playsinline preload="none" poster="/images/portfolio/film-concert.jpg" width="720" height="1280" aria-label="Film d’un concert réalisé par Zirar Focus">
          <source src="/videos/zirar-focus-reel-720p.mp4" type="video/mp4" />
          Votre navigateur ne prend pas en charge cette vidéo.
        </video>
        <figcaption>Film original · Zirar Focus</figcaption>
      </figure>
    </div>
  </section>

  <section class="locations-section">
    <div class="wrap locations-layout">
      <div><p class="eyebrow">Où nous retrouver</p><h2>Avignon comme ancrage.<br /><em>Le monde comme décor.</em></h2></div>
      <div class="locations">
        <div class="location"><span>01</span><strong>Avignon & Provence</strong><p>Mariages et événements dans le Vaucluse et le Sud de la France.</p></div>
        <div class="location"><span>02</span><strong>France</strong><p>Des histoires à raconter partout dans l’Hexagone.</p></div>
        <div class="location"><span>03</span><strong>Maroc & international</strong><p>Votre célébration, où qu’elle prenne vie.</p></div>
      </div>
    </div>
  </section>

  <section class="quote-panel">
    <div class="wrap"><p class="eyebrow eyebrow--light">Votre prochain chapitre</p><h2>Et si nous racontions<br /><em>votre histoire ensemble&nbsp;?</em></h2><p>Partagez la date, le lieu et l’atmosphère que vous imaginez. La conversation commence ici.</p><a class="button button--gold" href="/contact/#devis">Vérifier ma date <span class="arrow" aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
